[intake]
#---------------------+-------------------
# To                  | Transfer Coef.[%]
#---------------------+-------------------

# ICRP Publ.130 p.62 Para.92
# ICRP Publ.134 p.100 Table 5.2
  ET1-F                 $(      fr  *                  0% )
  ET2-F                 $(      fr  * (100% - 0.2%) * 20% )
  ETseq-F               $(      fr  *         0.2%  * 20% )
  BB-F                  $(      fr  * (100% - 0.2%) * 10% )
  BBseq-F               $(      fr  *         0.2%  * 10% )
  bb-F                  $(      fr  * (100% - 0.2%) * 20% )
  bbseq-F               $(      fr  *         0.2%  * 20% )
  ALV-F                 $(      fr  *                 50% )

  ET1-S                 $( (1 - fr) *                  0% )
  ET2-S                 $( (1 - fr) * (100% - 0.2%) * 20% )
  ETseq-S               $( (1 - fr) *         0.2%  * 20% )
  BB-S                  $( (1 - fr) * (100% - 0.2%) * 10% )
  BBseq-S               $( (1 - fr) *         0.2%  * 10% )
  bb-S                  $( (1 - fr) * (100% - 0.2%) * 20% )
  bbseq-S               $( (1 - fr) *         0.2%  * 20% )
  ALV-S                 $( (1 - fr) *                 50% )

  Environment           $(                             0% )
